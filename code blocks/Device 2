module Rcounter2 #(parameter clk_f = 50_000_000, //in MHz
                  parameter baud = 9600,
                  parameter oversample = 16, 
                  parameter half_bit = oversample/2,
                  parameter clk_per_bit16 = (clk_f)/(baud*oversample),
                  parameter Co = $clog2(clk_per_bit16 + 1))
(input wire clk, clear, CStart, output reg [Co-1:0] rcount, output reg [oversample-1:0] count_pos, output wire tick, sample);
//counter block
always @(posedge clk) begin
    if (clear || ~CStart) begin //keep the count 0 when nothing is transmitting.
        rcount <= 0;
    end else if (CStart) begin //when transmission starts.
        if (tick) rcount <= 0;  //if there is a tick reset the clk
        else rcount <= rcount + 1;  //otherwise count up.
    end
end
assign tick = (rcount == clk_per_bit16); //x16 faster than the agreed upon baud.

//pos count block
always @(posedge clk) begin
    if (clear || ~CStart) count_pos <= 0; //keep the pos count 0 when nothing is transmitting.
    else if (CStart && tick) begin //only when transmission is happening and tick is fired, 
        if (count_pos == oversample - 1) count_pos <= 0;
        else count_pos <= count_pos + 1;
       // if (tick) count_pos <= count_pos + 1;  //if there is a tick, count up the pos
        //else if (sample) count_pos <= 0;  //when 8th pos reached drop back to 0.  ---> this would fail to see the tick, as after sample <= 0 
//it would start from 0 again and in that misses a cycle, and checks for the tick after one cycle it has origianlly happened . The system never goes to 16 at all.
    end
end
assign sample = (count_pos == half_bit) && tick; //sampling at the mid. ---> there is no -1 caue it doesnt count to the end. &&tick ensure sample is high only at one cycle
endmodule


module shiftregisterSIPO2 #(parameter In = 8, //output bits.
                           parameter A = 11, //recieved bits.
                           parameter b = $clog2(A+1))
(input wire clk, Rin, clear, shift, output reg [In-1:0] Rout, output wire recieved, output reg flag, idal, output reg [b-1:0] rbitcount);
reg [A-1:0] sr; 
reg [In-1:0] D; 
//shiftregisterPISO DUT (.q(Rin)); //cant instantiate one module inside another one.

//synchronus edge detection was needed  ---> WATCHING OVER A WIRE.
reg Rpre, Rpre1;
always @(posedge clk) begin
    if (clear) begin
        Rpre <= 1'b0; //clear the memory to start fresh, so no earlier states interfere.
        Rpre1 <=1'b0; //clear the memory to start fresh, so no earlier states interfere.
    end else begin
        Rpre <= Rin; //has the present value
        Rpre1 <= Rpre; //two way flip flop //Rpre keeps the metastable value and let it stable for a cycle. Rpre1 keeps the stable value (past).
    end 
end
wire falling_E = ~Rpre & Rpre1; //detecting the falling edge. //for rising : ~Rpre & Rpre1
//wire idal = (rbitcount == 0);   ---> the clk will not start ever, as rbitcount is depended upon the clk itself.
wire watchman = falling_E & ~idal; //detecting if its the start bit or not. //idal = 0 ---> dont count, idal = 1 ---> count.
assign recieved = (rbitcount == A); //as recieved affacts both the always block beneath, so its needs to be in a hirarchial high poition.
//block for checking if its a start or not. HARD clear before every transmission and recieving.
always @(posedge clk ) begin
    if (clear) idal <= 1'b0; //keps the system idal as a falling edge approaches.
    else if (watchman) idal <= 1'b1; //busy line.
    else if (recieved) idal <= 1'b0; //line released.
end

//block for shifting
always @(posedge clk) begin
    if (clear)begin
        sr <= {A{1'b0}};
        rbitcount <= 0; //rbitcount <= A;   ---> this would trigger the recieved port on next edge, loading the wrong data to the regisster.
    end else if (shift) begin
        sr <= {Rin, sr[A-1:1]}; //sr <= {sr[A-1:1], Rin}; ---> this is stuck in one position just [0] gets changed.
        rbitcount <= rbitcount + 1;
    end
end

assign check = sr[A-2];  //the parity bit recieved check
assign RParity = ^sr[A-3:1];  //parity check
//block for flagg check
always @(posedge clk) begin
    if (clear) begin
        //Rout <= {In{1'b0}};   ---> this would erase the data after one clk cycle that it arrives, so the data will be vanished magically.
        flag <= 0;
    end else if (rbitcount == A) begin //because at 10th count you have all the data settle down, and on the 11th count everything resets.
            if (check != RParity) begin  //if parity doesn't match
            Rout <= {In{1'b0}}; 
            rbitcount <= 0; //reset count
            flag <= 1;
        end else begin
            Rout <= sr[A-3:1];
            sr <= {A{1'b0}}; 
            rbitcount <= 0; //reset count
            flag <= 0;
        end
    end
end
endmodule


