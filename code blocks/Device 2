module counter2 #(parameter baud_rate = 9600,
                 parameter clk_frequency = 50_000_000, //in MHz
                 parameter clk_per_bit = (clk_frequency)/baud_rate, // _ helps numbers to be represented in a cleaner way like ,.
                 parameter C = $clog2(clk_per_bit + 1)) //2^C = clk_per_bit; this is wrong. As 2^3 = 8; which needs 4 bits to represent
(input wire clk, EN, clear, sent, output reg [C-1:0] count, output wire countingdone); 
always @(posedge clk ) begin
    // repeat (11) begin //   ---> whithin an edge <= cant be updated. Non-blocking assignments updates only after finishing the edge.
    //while (count < 5208) begin   ---> whithin an edge <= cant be updated. Non-blocking assignments updates only after finishing the edge.
        if (clear || countingdone) count <= 0;  //13'd0; ---> will be constant, and error will occur when parameters changes.
        else if (sent) count <= 0; //when transmission is over.
        else if (EN) count <= count + 1;  //13'd1;  ---> will be constant, and error will occur when parameters changes.
    end   
assign countingdone = (count == clk_per_bit);
endmodule

