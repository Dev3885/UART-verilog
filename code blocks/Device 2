module shiftregisterPISO2 #(parameter I = 8,
                          parameter O = 11, 
                          parameter B = $clog2(O + 1)) // change the input, output and bitcount accordingly. B = bits used to represent
(input wire [I-1:0] data, input wire load, countingdone, clear, clk, output wire parity, start, q, stop, transmission, output reg [B-1:0] bitcount);
assign parity = ^data;
assign start = 0;
assign stop = 1;
reg [O-1:0] SR;
//register DUT(.Q(data)); //instantiating the register once.  ---> cant instantiate a module inside a module.
assign q = SR[0];
assign transmission = (bitcount == O);
always @(posedge clk) begin
    // while (count <11) begin   ---> whithin an edge <= cant be updated. Non-blocking assignments updates only after finishing the edge.
        //if (clear || transmission) SR[O-1:1] <= 0;  ---> cant do this together;
        //As when transmission is 1, the bitcount needs to hold the value O, but in clear everything goes to 0.
        if (clear) begin
            SR <= {O{1'b1}};
            bitcount <= O; //bitcount <= 0; ---> in this the system will think count has been reset, so it start shifting.
        end else if (load) begin  //bitcount reset to 0.
            SR <= {stop, parity, data, start};
            bitcount <= 0; //count goes 0 only when there is something to send.
            end  ////load is prioratized, because if Trnmsn is 1, load is also set to 1 on next cycle; causing a conflict.
        else if (transmission) SR <= {O{1'b1}}; //bitcount holds the value untill next load.
        else if (countingdone) begin // only triggers when 5208 counting is done.
            SR <= {1'b0, SR[O-1:1]};
            bitcount <= bitcount + 1; // 11'd1; ---> will be constant, and error will occur when parameters changes.
        end 
    end
endmodule
